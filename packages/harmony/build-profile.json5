{
  app: {
    // Signing stays out of the repo. Build an unsigned hap here and sign it with
    // hap-sign-tool (see scripts/build-harmony.mjs), or add a signingConfigs
    // block yourself and point material at $HOME/.paseo-harmony/signing.
    signingConfigs: [],
    products: [
      {
        name: "default",
        compileSdkVersion: "26.0.0",
        compatibleSdkVersion: "26.0.0",
        targetSdkVersion: "26.0.0",
        runtimeOS: "OpenHarmony",
        buildOption: {
          strictMode: {
            caseSensitiveCheck: true,
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    buildModeSet: [
      {
        name: "debug",
      },
      {
        name: "release",
      },
    ],
  },
  modules: [
    {
      name: "entry",
      srcPath: "./entry",
      targets: [
        {
          name: "default",
          applyToProducts: ["default"],
        },
      ],
    },
  ],
}
